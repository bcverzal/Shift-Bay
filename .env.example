# Shift Bay storage mode.
# local-json keeps the current data-file behavior.
# supabase stores the shared scheduler state document in Supabase.
SHIFT_BAY_STORAGE_MODE=local-json
PORT=8798
# Keep local-only unless another computer must connect directly to this server.
HOST=127.0.0.1

# Required only when SHIFT_BAY_STORAGE_MODE=supabase.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-service-role-key
SHIFT_BAY_LOCATION_ID=replace-with-location-uuid
SHIFT_BAY_DOCUMENT_KEY=primary

# Invitation email delivery (keep the API key server-side; never put it in app.js).
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=Shift Bay <invites@send.shift-bay.com>
